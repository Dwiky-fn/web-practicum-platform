# Backend Base API URL
VITE_API_URL=http://localhost:3000

# WebSocket Endpoints (Gunakan wss:// untuk SSL / Production)
VITE_EXECUTION_WS_URL=ws://localhost:3000/execution
VITE_LIVE_WORKSPACE_WS_URL=ws://localhost:3000/live-workspace
VITE_MONITORING_WS_URL=ws://localhost:3000/monitoring

# Google OAuth Client ID (SSO Login)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Debug & Environment Options
VITE_LIVE_WORKSPACE_DEBUG=false