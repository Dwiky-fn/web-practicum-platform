FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=""
ARG VITE_EXECUTION_WS_URL=""
ARG VITE_LIVE_WORKSPACE_WS_URL=""
ARG VITE_MONITORING_WS_URL=""
ARG VITE_GOOGLE_CLIENT_ID=""

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_EXECUTION_WS_URL=$VITE_EXECUTION_WS_URL
ENV VITE_LIVE_WORKSPACE_WS_URL=$VITE_LIVE_WORKSPACE_WS_URL
ENV VITE_MONITORING_WS_URL=$VITE_MONITORING_WS_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
