# Server Config
PORT=5000
NODE_ENV=development

# Internal Service Authentication
AI_SERVICE_API_KEY=your_ai_service_api_key_secret

# AI Provider Selection (mindrouter | ollama | gemini)
AI_PROVIDER=mindrouter

# MindRouter API Config (Primary Provider)
MINDROUTER_API_KEY=your_mindrouter_api_key
MINDROUTER_MODEL=openai/gpt-5.6-luna
MINDROUTER_BASE_URL=https://api.mindrouter.io/v1

# Ollama Local Engine Config (Fallback Provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b-it-qat

# Gemini API Config (Google Official - Alternative Provider)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# WorldGate API Config (Legacy - Disabled)
WORLDGATE_API_KEY=
WORLDGATE_MODEL=gpt-5.4-mini
WORLDGATE_BASE_URL=https://api.worldgateapi.com/v1/

# Model Evaluation Parameters
AI_TEMPERATURE=0.1
AI_CONTEXT_LENGTH=4096
AI_REQUEST_TIMEOUT_MS=300000
AI_MAX_CONCURRENT_REQUESTS=1
AI_MAX_RETRIES=2

# Webhook Callback Config
LMS_WEBHOOK_URL=https://be.dwkyjnrdi.my.id/api/internal/ai-callback

# Logging Config
LOG_LEVEL=info
LOG_AI_PAYLOADS=false
